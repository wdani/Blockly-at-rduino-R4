{
  "name": "blockly-at-rduino-r4",
  "version": "0.1.0-alpha.1",
  "description": "Blockly@rduino desktop fork with Arduino UNO R4 support",
  "main": "desktop/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdani/Blockly-at-rduino-R4.git"
  },
  "author": "Blockly@rduino contributors; UNO R4 fork by wdani",
  "license": "GPL-2.0-only",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ch.elekto.blocklyrduino.r4",
    "productName": "Blockly@rduino R4",
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!desktop/vendor/**",
      "!.git/**",
      "!.github/**"
    ],
    "extraResources": [
      {
        "from": "desktop/vendor/arduino-cli.exe",
        "to": "arduino-cli/arduino-cli.exe"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Blockly-rduino-R4-${version}-Windows-${arch}.${ext}"
  }
}
